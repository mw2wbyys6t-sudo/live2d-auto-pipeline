{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pygmalion Studio",
  "version": "0.10.10",
  "identifier": "com.pygmalion.studio",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": { "bundle/": "" },
    "externalBin": [],
    "copyright": "Copyright (c) 2026 Pygmalion",
    "category": "DeveloperTool",
    "shortDescription": "AI-powered Live2D character creation pipeline",
    "longDescription": "Pygmalion Studio (Pygmalion) - transform a text prompt into a rig-ready Live2D model through an automated pipeline.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
