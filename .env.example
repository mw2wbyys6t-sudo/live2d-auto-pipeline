# Live2D Master Agent v10.0 - Environment Configuration
# Copy this file to .env and fill in your API keys
# 复制此文件为 .env 并填入你的 API 密钥

# ==========================================
# Image Generation Providers (图生成)
# ==========================================

# Pollinations (FREE, no key needed - default)
# No configuration needed!

# Volcano Engine ARK / Seedream (火山引擎 / 豆包)
# Get key: https://console.volcengine.com/
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_VERSION=seedream-4.0
SEEDREAM_SIZE=1024x1024

# SenseNova (商汤日日新)
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://api.sensenova.cn/v1

# ==========================================
# LLM / Chat (大语言模型 / 对话)
# ==========================================

# OpenAI-compatible (works with OpenAI, DeepSeek, Moonshot, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=

# Local LLM via Ollama (optional, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ==========================================
# TTS / Voice (语音合成)
# ==========================================

# Edge TTS (FREE, no key needed - Microsoft Edge online TTS)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%

# OpenAI TTS (optional)
# OPENAI_TTS_MODEL=tts-1

# ==========================================
# ASR / Speech Recognition (语音识别)
# ==========================================
# Uses faster-whisper locally (no key needed)
WHISPER_MODEL=base
ASR_LANGUAGE=zh

# ==========================================
# Face Tracking (面部捕捉)
# ==========================================
MEDIAPIPE_CAMERA_ID=0
MEDIAPIPE_MIN_CONFIDENCE=0.5
TRACKING_SMOOTHING=0.5

# ==========================================
# Server (API 服务)
# ==========================================
GO_API_HOST=0.0.0.0
GO_API_PORT=8080
GO_API_TIMEOUT=120

# Redis (optional, for task queue)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Output & Storage
# ==========================================
OUTPUT_DIR=./output
ASSETS_DIR=./assets
MAX_UPLOAD_MB=50
MAX_PSD_SIZE_MB=500

# ==========================================
# Security
# ==========================================
# JWT secret for auth (auto-generated if empty)
JWT_SECRET=
# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

# ==========================================
# Logging
# ==========================================
LIVE2D_LOG_LEVEL=INFO
LIVE2D_TELEMETRY=0
