# Dependencies
node_modules/
__pycache__/
*.pyc

# Build artifacts
.next/
web/out/
dist/
build/
output/
*.egg-info/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Models & large files
*.onnx
*.pth
*.bin
*.safetensors

# Go build output
*.exe
api/live2d-api

# Temporary
.cache/
tmp/
*.tmp

# Local scratch & verification fixtures (never shipped)
Work/

# Machine-local toolchains (367 MB; a stale venv plus the Go module cache)
.venv-runtime/
.go-cache/
# Local dev venv (install.bat / install.sh create it; ~500 MB, never shipped)
.venv/
# Portable runtime built by scripts/build_portable.py (multi-GB) and the
# machine-specific config that points the desktop exe at it.
runtime/
config.portable.json

# Local agent/skill working state (the distilled versions live in docs/)
.autocase/
.superpowers/

# Local agent HTML share packages (large binary artifacts, never shipped)
.trae-html-share-packages/

# Assets (keep directory structure but ignore large files)
assets/characters/*.json
assets/models/

# Mimosa security hook state (local tooling, never commit)
.mimosa/

# Local dev-only server config (machine-specific absolute paths)
api/config.dev.json

# 浏览器面捕 WASM 运行时（约 33MB Emscripten 产物，第三方胶水代码）
# 已 vendored 到 web/public/mediapipe/wasm 供离线使用；不入库，缺失时前端自动回退 CDN
web/public/mediapipe/

# 桌面版构建产物（由 scripts/build_desktop.bat 生成）
dist/
# 注意：`dist/` 会连同目录本身一起忽略，父目录被排除后其下的 `!...` 反选不生效。
# 因此先显式放行目录，再忽略其内容、保留占位文件，
# 否则未打包 UI 时 dist 目录为空，go:embed all:dist 会直接报 "no matching files found"。
!api/webui/dist/
api/webui/dist/*
!api/webui/dist/.gitkeep

# ============================================================
# 增量补充：过程性产物（避免误入版本控制）
# 以下规则均为原 .gitignore 未覆盖的项；已存在的不再重复。
# 注意：已 git track 的文件不受 .gitignore 影响，无需 git rm --cached。
# ============================================================

# --- 运行时产物（增量） ---
output-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 工具产物（增量） ---
# .aider* 覆盖 .aider / .aider.conf.yml / .aider.chat.history.md 等
.aider*

# --- 本地缓存（增量） ---
.venv-*/
.npm-cache/

# --- 打包/编辑器临时产物（增量） ---
*.beacon.bak
*.bak
*~

# --- Next.js 构建产物（显式声明，即便顶层 .next/ 已涵盖同名目录） ---
web/.next/
web/.vercel/
web/.cache/

# --- Python 扩展模块构建产物 ---
*.so
*.dylib
*.dll
*.exe.manifest

# --- 模型缓存目录 ---
# 注意：项目内 api/models/ 为 Go 源码目录（已 track），故不使用全局 models/ 规则以免误伤。
# 大模型权重已由上方 *.onnx/*.pth/*.bin/*.safetensors 覆盖。
hf_cache/

# --- 用户上传/AI 工作区文件（不进入仓库） ---
# 由宿主环境在工作区根写入的临时文件，避免污染 git 状态
.uploads/

# --- 本机环境检测的产物（含个人机器信息，不入库） ---
desktop-env-report.txt

# --- 个人/本地配置 ---
*.local.json

# --- 加密密钥存储（虽为加密文件，但泄露后配合系统信息可能被解密） ---
.env.encrypted
.env*.encrypted

# --- 操作系统文件（增量） ---
desktop.ini

# --- Tauri 桌面壳构建产物 ---
desktop/target/
desktop/gen/

# Tauri 前端占位页面需要入库（tauri::generate_context! 编译时嵌入）
# 但顶层 dist/ 规则会把它一起忽略，所以先放行目录再保留 index.html
!desktop/dist/
desktop/dist/*
!desktop/dist/index.html

# Tauri 打包用的 Go 二进制（由 build_tauri_release 脚本复制进来，不入库）
# 保留 .gitkeep 让目录存在于 git 中，Tauri resources glob 才不会报错
desktop/bin/*
!desktop/bin/.gitkeep
