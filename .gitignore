# Dependencies
node_modules/
__pycache__/
*.pyc

# Build artifacts
.next/
web/out/
dist/
build/
output/
*.egg-info/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Models & large files
*.onnx
*.pth
*.bin
*.safetensors

# Go build output
*.exe
api/live2d-api

# Temporary
.cache/
tmp/
*.tmp

# Local scratch & verification fixtures (never shipped)
Work/

# Machine-local toolchains (367 MB; a stale venv plus the Go module cache)
.venv-runtime/
.go-cache/
# Local dev venv (install.bat / install.sh create it; ~500 MB, never shipped)
.venv/
# Portable runtime built by scripts/build_portable.py (multi-GB) and the
# machine-specific config that points the desktop exe at it.
runtime/
config.portable.json

# Local agent/skill working state (the distilled versions live in docs/)
.autocase/
.superpowers/

# Local agent HTML share packages (large binary artifacts, never shipped)
.trae-html-share-packages/

# Assets (keep directory structure but ignore large files)
assets/characters/*.json
assets/models/

# Mimosa security hook state (local tooling, never commit)
.mimosa/

# Local dev-only server config (machine-specific absolute paths)
api/config.dev.json

# 浏览器面捕 WASM 运行时（约 33MB Emscripten 产物，第三方胶水代码）
# 已 vendored 到 web/public/mediapipe/wasm 供离线使用；不入库，缺失时前端自动回退 CDN
web/public/mediapipe/

# 桌面版构建产物（由 scripts/build_desktop.bat 生成）
dist/
api/webui/dist/*
!api/webui/dist/.gitkeep
