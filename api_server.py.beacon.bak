# ==================== 角色管理端点 ====================

@app.get("/api/characters")
async def list_characters_endpoint():
    characters = list_characters()
    return api_response(data=characters)


@app.post("/api/characters")
async def create_character(req: CharacterRequest):
    now = datetime.now(timezone.utc).isoformat()
    card = {
        "character_id": generate_id(),
        "name": req.name,
        "created_at": now,
        "updated_at": now,
        "face": req.face or {
            "shape": "oval",
            "eye_shape": "almond",
            "eye_color": "#4a90d9",
            "eye_size": 1.0,
            "eyebrow_shape": "normal",
            "nose_type": "small",
            "mouth_type": "normal",
            "face_width_ratio": 1.0,
            "face_height_ratio": 1.0,
        },
        "hair": req.hair or {
            "color": "#3a2a1a",
            "style": "long",
            "length": 1.0,
            "bangs_style": "side",
            "highlights_color": "",
        },
        "body": req.body or {
            "type": "slim",
            "height_ratio": 1.0,
            "proportions": "normal",
        },
        "palette": req.palette or {
            "primary_colors": ["#4a90d9", "#e8b4b8"],
            "skin_tone": "#f5d5b8",
            "accent_color": "#ff6b6b",
        },
        "outfit": req.outfit or {
            "current": {},
            "wardrobe": [],
        },
        "references": {
            "front": req.ref_image or "",
            "side": "",
            "back": "",
        },
        "embedding": [],
        "persona": req.persona or {
            "personality": "",
            "voice_style": "",
            "backstory": "",
        },
        "style": req.style or {
            "constraints": "",
            "negative_prompt": "",
        },
    }
    
    save_character(card)
    return api_response(data=card, message="角色创建成功")


@app.get("/api/characters/{character_id}")
async def get_character(character_id: str):
    card = load_character(character_id)
    if not card:
        raise HTTPException(status_code=404, detail="角色不存在")
    return api_response(data=card)


@app.put("/api/characters/{character_id}")
async def update_character(character_id: str, req: CharacterRequest):
    card = load_character(character_id)
    if not card:
        raise HTTPException(status_code=404, detail="角色不存在")
    
    if req.name:
        card["name"] = req.name
    if req.face:
        card["face"].update(req.face)
    if req.hair:
        card["hair"].update(req.hair)
    if req.body:
        card["body"].update(req.body)
    if req.palette:
        card["palette"].update(req.palette)
    if req.persona:
        card["persona"].update(req.persona)
    if req.style:
        card["style"].update(req.style)
    
    card["updated_at"] = datetime.now(timezone.utc).isoformat()
    save_character(card)
    return api_response(data=card, message="角色更新成功")


@app.delete("/api/characters/{character_id}")
async def delete_character(character_id: str):
    path = CHARACTERS_DIR / f"{character_id}.json"
    if path.exists():
        path.unlink()
        return api_response(message="角色删除成功")
    raise HTTPException(status_code=404, detail="角色不存在")


# ==================== 图像生成端点 ====================

@app.post("/api/generate")
async def generate_image(req: GenerateImageRequest):
    """简单图像生成（使用 Pollinations 免费 API）"""
    try:
        from core.image_gen.pollinations import PollinationsGenerator
        
        generator = PollinationsGenerator()
        result = generator.generate(
            prompt=req.prompt,
            width=req.width,
            height=req.height,
            seed=req.seed,
            negative_prompt=req.negative_prompt,
        )
        
        image_path = result.get("image_path", "")
        image_filename = os.path.basename(image_path) if image_path else ""
        
        return api_response(data={
            "image_path": image_path,
            "image_url": f"/output/{image_filename}" if image_filename else "",
            "seed": result.get("seed", req.seed),
            "width": req.width,
            "height": req.height,
            "source": "pollinations",
            "created_at": datetime.now(timezone.utc).isoformat(),
            "success": True,
        })
    except Exception as e:
        return api_response(error=str(e), success=False)


@app.post("/api/generate/character")
async def generate_character(req: GenerateRequest):
    """完整角色生成工作流"""
    try:
        from core.workflow import WorkflowEngine
        
        engine = WorkflowEngine(
            output_dir=str(OUTPUT_DIR),
            provider="auto",
        )
        
        result = engine.run(
            prompt=req.prompt,
            character_id=req.character_id,
            use_semantic=req.use_semantic,
            export_live2d=req.export_live2d,
            deploy_desktop=req.deploy_desktop,
            width=req.width,
            height=req.height,
            seed=req.seed,
            negative_prompt=req.negative_prompt,
        )
        
        return api_response(data={
            "image_path": result.get("image_path", ""),
            "image_url": result.get("image_url", ""),
            "seed": result.get("seed", 0),
            "width": req.width,
            "height": req.height,
            "source": "workflow_v10.1",
            "layers_dir": result.get("layers_dir", ""),
            "psd_path": result.get("psd_path", ""),
            "model3_json": result.get("model3_json", ""),
            "output_dir": result.get("output_dir", ""),
            "character_id": result.get("character_id", ""),
            "success": True,
            "steps": result.get("steps", {}),
            "created_at": datetime.now(timezone.utc).isoformat(),
        })
    except Exception as e:
        return api_response(error=str(e), success=False)


# ==================== PSD 分层端点 ====================

@app.post("/api/psd-plan")
async def create_psd_plan(request: Request):
    try:
        body = await request.json()
        image_path = body.get("image_path", "")
        if not image_path:
            return api_response(error="缺少 image_path 参数", success=False)
        
        return api_response(data={
            "plan_dir": "",
            "psd_path": "",
            "layer_count": 0,
            "layers": [],
            "created_at": datetime.now(timezone.utc).isoformat(),
        }, message="PSD 分层规划功能开发中")
    except Exception as e:
        return api_response(error=str(e), success=False)


