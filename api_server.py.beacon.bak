# ==================== 聊天端点 ====================

@app.post("/api/chat")
async def chat(req: ChatRequest):
    try:
        reply = f"收到你的消息：{req.message}\n\n（聊天功能需要配置 LLM 提供商后才能使用）"
        return api_response(data={
            "reply": reply,
            "emotion": "neutral",
            "action": "",
            "finished": True,
        })
    except Exception as e:
        return api_response(error=str(e), success=False)


@app.post("/api/chat/stream")
async def chat_stream(req: ChatRequest):
    """流式聊天 - 返回 SSE 格式"""
    from fastapi.responses import StreamingResponse
    import asyncio
    
    async def generate():
        reply = f"收到你的消息：{req.message}\n\n（聊天功能需要配置 LLM 提供商后才能使用）"
        for char in reply:
            chunk = json.dumps({
                "type": "token",
                "content": char,
                "finished": False,
            })
            yield f"data: {chunk}\n\n"
            await asyncio.sleep(0.02)
        
        final_chunk = json.dumps({
            "type": "done",
            "finished": True,
            "emotion": "neutral",
        })
        yield f"data: {final_chunk}\n\n"
    
    return StreamingResponse(generate(), media_type="text/event-stream")


# ==================== WebSocket 端点 ====================

@app.websocket("/api/ws")
async def websocket_endpoint(websocket):
    await websocket.accept()
    try:
        while True:
            data = await websocket.receive_text()
            await websocket.send_json({"type": "pong", "time": int(time.time() * 1000)})
    except Exception:
        pass


@app.websocket("/ws/progress")
async def ws_progress(websocket):
    await websocket.accept()
    try:
        while True:
            data = await websocket.receive_text()
            await websocket.send_json({"type": "ping", "time": int(time.time() * 1000)})
    except Exception:
        pass


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
