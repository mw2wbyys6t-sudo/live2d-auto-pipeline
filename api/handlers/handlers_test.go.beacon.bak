// TestResponseShape 验证 Response 结构体的 JSON 字段名（保证前端能正确解析）
func TestResponseShape(t *testing.T) {
	r := models.Response{Success: true, Message: "test", Data: "x"}
	b, _ := json.Marshal(r)
	got := string(b)
	for _, k := range []string{`"success"`, `"message"`, `"data"`} {
		if !contains(got, k) {
			t.Errorf("expected key %s in JSON: %s", k, got)
		}
	}
}

func contains(s, sub string) bool {
	return bytes.Contains([]byte(s), []byte(sub))
}

// --- P0 security / chat-context regression tests ---

func TestIsPathSafe(t *testing.T) {
	base := t.TempDir()
	// Legitimate file inside base.
	good := filepath.Join(base, "character.png")
	if !isPathSafe(good, base) {
		t.Error("expected in-base path to be safe")
	}
	// Directory traversal must be rejected.
	if isPathSafe(filepath.Join(base, "..", "..", "etc", "passwd"), base) {
		t.Error("expected ../ traversal to be rejected")
	}
	// Null byte injection must be rejected.
	if isPathSafe(filepath.Join(base, "bad\x00.png"), base) {
		t.Error("expected null byte path to be rejected")
	}
}

func TestServeOutputRejectsTraversal(t *testing.T) {
	h := newTestHandler(t)
	r := gin.New()
	r.GET("/output/:filename", h.ServeOutput)

	req := httptest.NewRequest(http.MethodGet, "/output/..%2f..%2fetc%2fpasswd", nil)
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)
	// Must not serve the file; either 403/404/400 is acceptable.
	if w.Code == http.StatusOK {
		t.Errorf("traversal should not return 200, got %d", w.Code)
	}
}

func TestChatEndpoint(t *testing.T) {
	h := newTestHandler(t)
	r := gin.New()
	r.POST("/api/chat", h.Chat)

	body := `{"message":"你好呀","session_id":"sess-abc"}`
	req := httptest.NewRequest(http.MethodPost, "/api/chat", bytes.NewBufferString(body))
	req.Header.Set("Content-Type", "application/json")
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d (body: %s)", w.Code, w.Body.String())
	}
	var resp models.Response
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}
	if !resp.Success {
		t.Errorf("expected success=true, body: %s", w.Body.String())
	}
}

func TestChatEndpointSessionIDCasing(t *testing.T) {
	h := newTestHandler(t)
	r := gin.New()
	r.POST("/api/chat", h.Chat)

	for _, key := range []string{"session_id", "sessionId", "SessionID", "SESSION_ID"} {
		body := `{"message":"hi","` + key + `":"sess-casing"}`
		req := httptest.NewRequest(http.MethodPost, "/api/chat", bytes.NewBufferString(body))
		req.Header.Set("Content-Type", "application/json")
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)
		if w.Code != http.StatusOK {
			t.Fatalf("key %q: expected 200, got %d (body: %s)", key, w.Code, w.Body.String())
		}
	}
}

